# ---------------------------------------------------------------------------
# Ligmax GUI configuration.  Copy to `.env` and change the keys.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Grants read/write (admin) access.  Open the dashboard once as
#   https://live.ligmax.no/?key=<LIGMAX_ADMIN_KEY>
# and the server moves the key into an HttpOnly cookie and redirects to `/`,
# so the key never stays visible in the address bar.
LIGMAX_ADMIN_KEY=change-me-admin-key

# Shared secret the vessel uses to push telemetry (Authorization: Bearer ...,
# or an "auth" field in a UDP frame).  Never hand this one out.
LIGMAX_BOAT_KEY=change-me-boat-key

# Signs the admin cookie so the cookie value is not the key itself.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
LIGMAX_COOKIE_SECRET=change-me-to-a-long-random-string

# How long an admin session lasts, in hours.
LIGMAX_SESSION_HOURS=12

# Set to 1 to let anyone read the dashboard without a key (default).
# Set to 0 to require the admin key even for read-only viewing.
# NOTE: with live.ligmax.no pointed at this server, 1 means the whole internet
# can watch the telemetry (they still cannot send commands).
LIGMAX_PUBLIC_READ=1

# Shared secret the update pollers on each node present when they ask "has anyone
# pressed Update for my repo?".  Defaults to LIGMAX_BOAT_KEY if unset, so you only
# need this if you want the vessel and the deploy pollers on separate secrets.
LIGMAX_NODE_KEY=

# Repos the dashboard shows an Update button for, in display order.
# Leave unset for the default: server, pi, edge, ai, subsystems.
LIGMAX_REPOS=

# HTTP server.
#
# Behind a TLS reverse proxy (the normal setup: Caddy terminates HTTPS on 443 for
# live.ligmax.no and forwards here) bind to localhost so nothing external can reach
# Flask directly:
#     LIGMAX_HOST=127.0.0.1
# Use 0.0.0.0 only when serving plain HTTP on your LAN with no proxy in front.
# Do NOT set LIGMAX_PORT=443: that needs root, and Flask should not terminate TLS.
LIGMAX_HOST=127.0.0.1
LIGMAX_PORT=3338

# UDP telemetry ingest.  Set port to 0 to disable the UDP listener and use
# only HTTP POST /api/ingest.
LIGMAX_UDP_HOST=0.0.0.0
LIGMAX_UDP_PORT=8771

# --- RTK / NTRIP caster ----------------------------------------------------
#
# rtk.ligmax.no:2101 is forwarded to this box.  The base station and the vessel
# are both on 4G, so neither can accept a connection: both dial out to here and
# the caster pipes one to the other.  DNS-only in Cloudflare - NTRIP is not
# HTTPS, so the proxy cannot carry it (docs/hosting.md).
LIGMAX_RTK_ENABLED=1
LIGMAX_RTK_HOST=0.0.0.0
LIGMAX_RTK_PORT=2101
LIGMAX_RTK_MOUNT=LIGMAX1

# Password the BASE STATION presents when it pushes corrections.  Left blank,
# both ends fall back to a literal committed in ligmax_gui/rtk.py and
# ligmax-subsystems/rtk/base_station.py so the base can come up before this file
# can be edited - but that literal is in a public repo, so it is a placeholder,
# not a secret.  A rover applies whatever RTCM it is handed and still reports RTK
# FIXED, which makes an open source port a position-integrity problem.  Set this
# on the caster and the base station, matching.  It travels in clear over NTRIP,
# so do not reuse LIGMAX_ADMIN_KEY or LIGMAX_BOAT_KEY here.
LIGMAX_RTK_SOURCE_PASSWORD=

# Optional credentials the ROVER (and any survey app) must present to read the
# corrections.  Leave blank for an open mountpoint; reading costs only uplink.
LIGMAX_RTK_USER=
LIGMAX_RTK_PASSWORD=

# Approximate base position, whole degrees is plenty - it only fills the
# sourcetable so clients can see which base they are pointed at.  The precise
# coordinates live on the base station itself, and getting *those* wrong moves
# the boat silently (docs/hosting.md).
LIGMAX_RTK_BASE_LAT=63.44
LIGMAX_RTK_BASE_LON=10.42

# --- saved stabilisation tuning --------------------------------------------
#
# Named snapshots of the roll and pitch gains and trims, written by the tuning
# panel on /control.  The only file this server writes: everything else here is
# RAM-only and dies with the process, which is the wrong trade for numbers that
# took a bench session to find.  The vessel keeps each value in the flight
# controller's own storage as well - this copy is what survives a parameter reset,
# a firmware flash or a swapped Pixhawk.  Defaults to tuning-profiles.json beside
# run.py, which is gitignored; point it somewhere backed up if you have such a
# place on the ground station.
LIGMAX_TUNING_STORE=

# Optional: raise if you stream very large lidar scans.
LIGMAX_MAX_SCAN_POINTS=1500
LIGMAX_LOG_BUFFER=4000
